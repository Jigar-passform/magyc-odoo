<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_magyc_transfer_wizard_form" model="ir.ui.view">
        <field name="name">magyc.transfer.wizard.form</field>
        <field name="model">magyc.transfer.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="source_warehouse_id"/>
                        <field name="dest_warehouse_id"/>
                    </group>
                    <group>
                        <field name="pallets"/>
                        <field name="trays_per_pallet"/>
                        <field name="note"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_transfer" type="object"
                            string="Transfer buchen" class="btn-primary"/>
                    <button string="Abbrechen" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
