<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_magyc_ops" model="ir.ui.view">
        <field name="name">res.company.form.magyc.ops</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Kiosk-Prozess (MAGYC)" name="magyc_ops">
                    <group>
                        <group string="Erstbestückung und Nachschub">
                            <field name="magyc_first_fill_trays"/>
                            <field name="magyc_first_fill_trays_per_product"/>
                            <field name="magyc_refill_min_trays"/>
                            <field name="magyc_return_months"/>
                        </group>
                        <group string="Provisionen und Prämien">
                            <field name="magyc_akquisiteur_fee"/>
                            <field name="magyc_akquisiteur_product_id"/>
                            <field name="magyc_bonus_amount"/>
                            <field name="magyc_finance_user_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Logistik">
                            <field name="magyc_trays_per_pallet"/>
                            <field name="magyc_pfand_shop_price"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
