<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="tpl_reminder_1" model="mail.template">
        <field name="name">MAGYC Zahlungserinnerung</field>
        <field name="model_id" ref="account.model_res_partner"/>
        <field name="email_from">{{ object._get_followup_responsible().email_formatted }}</field>
        <field name="partner_to" eval="False"/>
        <field name="subject">Zahlungserinnerung – offene Rechnung</field>
        <field name="description">Freundliche Zahlungserinnerung (MAGYC)</field>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;font-size:13px;">
                <p>Sehr geehrte Damen und Herren,</p>
                <p>Sicher ist es Ihrer Aufmerksamkeit entgangen: Die folgende Rechnung ist noch offen.</p>
                <p>Offener Betrag:
                    <b>
                        <t t-if="ctx.get('amount_due')">
                            <t t-out="format_amount(ctx.get('amount_due'), object.currency_id)"/>
                        </t>
                        <t t-else="">
                            <t t-out="format_amount(object.total_overdue_followup, object.currency_id)"/>
                        </t>
                    </b>
                </p>
                <p>Bitte überweisen Sie den Betrag in den nächsten 7 Tagen. Hat sich Ihre Zahlung
                    überschnitten, betrachten Sie dieses Schreiben als gegenstandslos.</p>
                <p>Freundliche Grüße<br/><t t-out="object.company_id.name"/></p>
            </div>
        </field>
    </record>

    <record id="tpl_reminder_2" model="mail.template">
        <field name="name">MAGYC 1. Mahnung</field>
        <field name="model_id" ref="account.model_res_partner"/>
        <field name="email_from">{{ object._get_followup_responsible().email_formatted }}</field>
        <field name="partner_to" eval="False"/>
        <field name="subject">1. Mahnung – Zahlungsverzug</field>
        <field name="description">Erste Mahnung (MAGYC)</field>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;font-size:13px;">
                <p>Sehr geehrte Damen und Herren,</p>
                <p>Leider konnten wir bis heute keinen Zahlungseingang feststellen.</p>
                <p>Offener Betrag:
                    <b>
                        <t t-if="ctx.get('amount_due')">
                            <t t-out="format_amount(ctx.get('amount_due'), object.currency_id)"/>
                        </t>
                        <t t-else="">
                            <t t-out="format_amount(object.total_overdue_followup, object.currency_id)"/>
                        </t>
                    </b>
                </p>
                <p>Bitte begleichen Sie den Betrag innerhalb von 7 Tagen. Bis zum Ausgleich sind weitere
                    Lieferungen gesperrt.</p>
                <p>Freundliche Grüße<br/><t t-out="object.company_id.name"/></p>
            </div>
        </field>
    </record>

    <record id="tpl_reminder_3" model="mail.template">
        <field name="name">MAGYC 2. Mahnung</field>
        <field name="model_id" ref="account.model_res_partner"/>
        <field name="email_from">{{ object._get_followup_responsible().email_formatted }}</field>
        <field name="partner_to" eval="False"/>
        <field name="subject">2. Mahnung – letzte Zahlungsaufforderung</field>
        <field name="description">Zweite Mahnung (MAGYC)</field>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;font-size:13px;">
                <p>Sehr geehrte Damen und Herren,</p>
                <p>Trotz Erinnerung ist die folgende Rechnung weiterhin offen.</p>
                <p>Offener Betrag:
                    <b>
                        <t t-if="ctx.get('amount_due')">
                            <t t-out="format_amount(ctx.get('amount_due'), object.currency_id)"/>
                        </t>
                        <t t-else="">
                            <t t-out="format_amount(object.total_overdue_followup, object.currency_id)"/>
                        </t>
                    </b>
                </p>
                <p>Bitte zahlen Sie innerhalb von 5 Tagen. Andernfalls behalten wir uns weitere Schritte
                    vor, einschließlich Rückholung der Kommissionsware.</p>
                <p>Freundliche Grüße<br/><t t-out="object.company_id.name"/></p>
            </div>
        </field>
    </record>

    <function model="account_followup.followup.line" name="_magyc_setup_dunning"/>
</odoo>
