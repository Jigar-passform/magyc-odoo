<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_magyc_document_text_list" model="ir.ui.view">
        <field name="name">magyc.document.text.list</field>
        <field name="model">magyc.document.text</field>
        <field name="arch" type="xml">
            <list string="Belegtexte">
                <field name="doc_type"/>
                <field name="intro"/>
                <field name="outro"/>
                <field name="sequence" widget="handle"/>
            </list>
        </field>
    </record>

    <record id="view_magyc_document_text_form" model="ir.ui.view">
        <field name="name">magyc.document.text.form</field>
        <field name="model">magyc.document.text</field>
        <field name="arch" type="xml">
            <form string="Belegtext">
                <sheet>
                    <group>
                        <field name="doc_type"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <field name="intro" placeholder="Einleitungstext…"/>
                    <field name="outro" placeholder="Schlusstext…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_magyc_document_text" model="ir.actions.act_window">
        <field name="name">Belegtexte</field>
        <field name="res_model">magyc.document.text</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_magyc_document_text" name="Belegtexte" parent="magyc_commission.menu_magyc_root"
              action="action_magyc_document_text" sequence="20"/>
</odoo>
