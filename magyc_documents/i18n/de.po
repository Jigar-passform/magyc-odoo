#. module: magyc_documents
#: model:mail.template,subject:magyc_documents.tpl_reminder_2
msgid "1. Mahnung – Zahlungsverzug"
msgstr "1. Mahnung – Zahlungsverzug"

#. module: magyc_documents
#: model:mail.template,subject:magyc_documents.tpl_reminder_3
msgid "2. Mahnung – letzte Zahlungsaufforderung"
msgstr "2. Mahnung – letzte Zahlungsaufforderung"

#. module: magyc_documents
#: model:mail.template,body_html:magyc_documents.tpl_reminder_2
msgid ""
"<div style=\"margin:0;padding:0;font-size:13px;\">\n"
"                <p>Sehr geehrte Damen und Herren,</p>\n"
"                <p>Leider konnten wir bis heute keinen Zahlungseingang feststellen.</p>\n"
"                <p>Offener Betrag:\n"
"                    <b>\n"
"                        <t t-if=\"ctx.get('amount_due')\">\n"
"                            <t t-out=\"format_amount(ctx.get('amount_due'), object.currency_id)\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"format_amount(object.total_overdue_followup, object.currency_id)\"/>\n"
"                        </t>\n"
"                    </b>\n"
"                </p>\n"
"                <p>Bitte begleichen Sie den Betrag innerhalb von 7 Tagen. Bis zum Ausgleich sind weitere\n"
"                    Lieferungen gesperrt.</p>\n"
"                <p>Freundliche Grüße<br/><t t-out=\"object.company_id.name\"/></p>\n"
"            </div>\n"
"        "
msgstr "<div style=\"margin:0;padding:0;font-size:13px;\">\n                <p>Sehr geehrte Damen und Herren,</p>\n                <p>Leider konnten wir bis heute keinen Zahlungseingang feststellen.</p>\n                <p>Offener Betrag:\n                    <b>\n                        <t t-if=\"ctx.get('amount_due')\">\n                            <t t-out=\"format_amount(ctx.get('amount_due'), object.currency_id)\"/>\n                        </t>\n                        <t t-else=\"\">\n                            <t t-out=\"format_amount(object.total_overdue_followup, object.currency_id)\"/>\n                        </t>\n                    </b>\n                </p>\n                <p>Bitte begleichen Sie den Betrag innerhalb von 7 Tagen. Bis zum Ausgleich sind weitere\n                    Lieferungen gesperrt.</p>\n                <p>Freundliche Grüße<br/><t t-out=\"object.company_id.name\"/></p>\n            </div>\n        "

#. module: magyc_documents
#: model:mail.template,body_html:magyc_documents.tpl_reminder_1
msgid ""
"<div style=\"margin:0;padding:0;font-size:13px;\">\n"
"                <p>Sehr geehrte Damen und Herren,</p>\n"
"                <p>Sicher ist es Ihrer Aufmerksamkeit entgangen: Die folgende Rechnung ist noch offen.</p>\n"
"                <p>Offener Betrag:\n"
"                    <b>\n"
"                        <t t-if=\"ctx.get('amount_due')\">\n"
"                            <t t-out=\"format_amount(ctx.get('amount_due'), object.currency_id)\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"format_amount(object.total_overdue_followup, object.currency_id)\"/>\n"
"                        </t>\n"
"                    </b>\n"
"                </p>\n"
"                <p>Bitte überweisen Sie den Betrag in den nächsten 7 Tagen. Hat sich Ihre Zahlung\n"
"                    überschnitten, betrachten Sie dieses Schreiben als gegenstandslos.</p>\n"
"                <p>Freundliche Grüße<br/><t t-out=\"object.company_id.name\"/></p>\n"
"            </div>\n"
"        "
msgstr "<div style=\"margin:0;padding:0;font-size:13px;\">\n                <p>Sehr geehrte Damen und Herren,</p>\n                <p>Sicher ist es Ihrer Aufmerksamkeit entgangen: Die folgende Rechnung ist noch offen.</p>\n                <p>Offener Betrag:\n                    <b>\n                        <t t-if=\"ctx.get('amount_due')\">\n                            <t t-out=\"format_amount(ctx.get('amount_due'), object.currency_id)\"/>\n                        </t>\n                        <t t-else=\"\">\n                            <t t-out=\"format_amount(object.total_overdue_followup, object.currency_id)\"/>\n                        </t>\n                    </b>\n                </p>\n                <p>Bitte überweisen Sie den Betrag in den nächsten 7 Tagen. Hat sich Ihre Zahlung\n                    überschnitten, betrachten Sie dieses Schreiben als gegenstandslos.</p>\n                <p>Freundliche Grüße<br/><t t-out=\"object.company_id.name\"/></p>\n            </div>\n        "

#. module: magyc_documents
#: model:mail.template,body_html:magyc_documents.tpl_reminder_3
msgid ""
"<div style=\"margin:0;padding:0;font-size:13px;\">\n"
"                <p>Sehr geehrte Damen und Herren,</p>\n"
"                <p>Trotz Erinnerung ist die folgende Rechnung weiterhin offen.</p>\n"
"                <p>Offener Betrag:\n"
"                    <b>\n"
"                        <t t-if=\"ctx.get('amount_due')\">\n"
"                            <t t-out=\"format_amount(ctx.get('amount_due'), object.currency_id)\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"format_amount(object.total_overdue_followup, object.currency_id)\"/>\n"
"                        </t>\n"
"                    </b>\n"
"                </p>\n"
"                <p>Bitte zahlen Sie innerhalb von 5 Tagen. Andernfalls behalten wir uns weitere Schritte\n"
"                    vor, einschließlich Rückholung der Kommissionsware.</p>\n"
"                <p>Freundliche Grüße<br/><t t-out=\"object.company_id.name\"/></p>\n"
"            </div>\n"
"        "
msgstr "<div style=\"margin:0;padding:0;font-size:13px;\">\n                <p>Sehr geehrte Damen und Herren,</p>\n                <p>Trotz Erinnerung ist die folgende Rechnung weiterhin offen.</p>\n                <p>Offener Betrag:\n                    <b>\n                        <t t-if=\"ctx.get('amount_due')\">\n                            <t t-out=\"format_amount(ctx.get('amount_due'), object.currency_id)\"/>\n                        </t>\n                        <t t-else=\"\">\n                            <t t-out=\"format_amount(object.total_overdue_followup, object.currency_id)\"/>\n                        </t>\n                    </b>\n                </p>\n                <p>Bitte zahlen Sie innerhalb von 5 Tagen. Andernfalls behalten wir uns weitere Schritte\n                    vor, einschließlich Rückholung der Kommissionsware.</p>\n                <p>Freundliche Grüße<br/><t t-out=\"object.company_id.name\"/></p>\n            </div>\n        "

