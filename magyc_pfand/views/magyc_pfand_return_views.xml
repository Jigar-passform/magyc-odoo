<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_magyc_pfand_return_form" model="ir.ui.view">
        <field name="name">magyc.pfand.return.form</field>
        <field name="model">magyc.pfand.return</field>
        <field name="arch" type="xml">
            <form string="Pfand-Rücknahme">
                <header>
                    <button name="action_create_credit_note" type="object" string="Gutschrift erstellen"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="credit_note_id" invisible="not credit_note_id"/>
                            <field name="qty_total"/>
                            <field name="amount_untaxed"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="price_unit"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Bemerkungen…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_magyc_pfand_return_list" model="ir.ui.view">
        <field name="name">magyc.pfand.return.list</field>
        <field name="model">magyc.pfand.return</field>
        <field name="arch" type="xml">
            <list string="Pfand-Rücknahmen">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="qty_total"/>
                <field name="amount_untaxed"/>
                <field name="state" widget="badge"/>
                <field name="credit_note_id"/>
            </list>
        </field>
    </record>

    <record id="action_magyc_pfand_return" model="ir.actions.act_window">
        <field name="name">Pfand-Rücknahme</field>
        <field name="res_model">magyc.pfand.return</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_magyc_pfand_return" name="Pfand-Rücknahme"
              parent="magyc_commission.menu_magyc_root" action="action_magyc_pfand_return" sequence="30"/>
</odoo>
