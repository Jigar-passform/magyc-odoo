<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_magyc_commission" model="ir.ui.view">
        <field name="name">res.company.form.magyc.commission</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Kommission (MAGYC)" name="magyc_commission">
                    <group>
                        <group>
                            <field name="magyc_quality_location_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
