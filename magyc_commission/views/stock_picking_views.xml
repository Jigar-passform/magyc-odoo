<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_magyc_handover" model="ir.ui.view">
        <field name="name">stock.picking.form.magyc.handover</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Übergabe" name="magyc_handover"
                      invisible="not magyc_is_handover">
                    <group>
                        <group>
                            <field name="magyc_signer_name"/>
                            <field name="magyc_vehicle_location_id"/>
                            <field name="magyc_first_fill_trays"/>
                        </group>
                        <group>
                            <field name="magyc_handover_note"/>
                        </group>
                    </group>
                    <group string="Nachweis">
                        <field name="magyc_photo" widget="image" class="oe_avatar"/>
                        <field name="magyc_signature" widget="image" class="oe_avatar"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
