<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_abverkauf" model="ir.actions.report">
        <field name="name">Abverkaufsmeldung</field>
        <field name="model">magyc.abverkauf</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">magyc_commission.report_abverkauf</field>
        <field name="print_report_name">'Abverkauf-%s' % (object.name)</field>
    </record>

    <template id="report_abverkauf_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Abverkaufsmeldung <t t-out="o.name"/></h2>
                <div class="row mt-3">
                    <div class="col-6">
                        <strong>Kiosk</strong>
                        <div t-field="o.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    </div>
                    <div class="col-6">
                        <strong>Zeitraum</strong>
                        <div><span t-field="o.date_from"/> – <span t-field="o.date_to"/></div>
                        <div>Kommissionslager: <span t-field="o.location_id"/></div>
                    </div>
                </div>
                <table class="table table-sm mt-4">
                    <thead>
                        <tr>
                            <th>Artikel</th>
                            <th class="text-end">Abverkauf</th>
                            <th class="text-end">Rückgabe</th>
                            <th class="text-end">Preis netto</th>
                            <th class="text-end">Summe netto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <td><span t-field="line.product_id"/></td>
                            <td class="text-end"><span t-field="line.qty_sold"/></td>
                            <td class="text-end"><span t-field="line.qty_returned"/></td>
                            <td class="text-end"><span t-field="line.price_unit"/></td>
                            <td class="text-end">
                                <span t-out="'%.2f' % (line.qty_sold * line.price_unit)"/> €
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3"/>
                            <td class="text-end"><strong>Gesamt netto</strong></td>
                            <td class="text-end"><strong><span t-field="o.amount_untaxed"/> €</strong></td>
                        </tr>
                    </tfoot>
                </table>
                <p class="mt-3">Getränk und Pfand je 19 % USt. Abgerechnet wird nur der bestätigte Abverkauf;
                    unverkaufte Ware kann zurückgegeben werden.</p>
                <div class="row mt-5">
                    <div class="col-6">
                        Abverkauf bestätigt:<br/><br/>
                        ______________________________<br/>
                        Unterschrift Kiosk, Datum
                    </div>
                    <div class="col-6">
                        Für MAGYC DRINKS GmbH:<br/><br/>
                        ______________________________<br/>
                        Unterschrift, Datum
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_abverkauf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="magyc_commission.report_abverkauf_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
