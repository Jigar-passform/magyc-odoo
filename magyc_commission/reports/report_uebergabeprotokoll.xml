<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_uebergabeprotokoll" model="report.paperformat">
        <field name="name">MAGYC Übergabeprotokoll A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">20</field>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_uebergabeprotokoll" model="ir.actions.report">
        <field name="name">Übergabeprotokoll Kommission</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">magyc_commission.report_uebergabeprotokoll</field>
        <field name="paperformat_id" ref="paperformat_uebergabeprotokoll"/>
        <field name="print_report_name">'Uebergabeprotokoll-%s' % (object.name)</field>
    </record>

    <template id="report_uebergabeprotokoll_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Übergabeprotokoll Kommission</h2>
                <p>Folgende Ware wird Ihnen als Kommissionsware übergeben. Die Ware bleibt bis zum Verkauf
                    Eigentum der MAGYC DRINKS GmbH.</p>
                <div class="row mt-3">
                    <div class="col-6">
                        <strong>Kiosk</strong>
                        <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    </div>
                    <div class="col-6">
                        <strong>Beleg</strong>
                        <div t-field="o.name"/>
                        <div t-field="o.scheduled_date"/>
                    </div>
                </div>
                <table class="table table-sm mt-4">
                    <thead>
                        <tr>
                            <th>Artikel</th>
                            <th class="text-end">Menge</th>
                            <th>Charge</th>
                            <th>MHD</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.move_ids" t-as="move">
                            <td><span t-field="move.product_id"/></td>
                            <td class="text-end"><span t-field="move.quantity"/></td>
                            <td>
                                <span t-foreach="move.move_line_ids" t-as="ml" t-esc="ml.lot_id.name or ''"/>
                            </td>
                            <td>
                                <span t-foreach="move.move_line_ids" t-as="ml" t-esc="ml.lot_id.expiration_date or ''"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p class="mt-4">Abgerechnet wird monatlich nur der bestätigte Abverkauf. Unverkaufte Ware kann
                    zurückgegeben werden.</p>
                <div class="row mt-5">
                    <div class="col-6">
                        Ware übernommen:<br/><br/>
                        ______________________________<br/>
                        Unterschrift, Datum
                    </div>
                    <div class="col-6">
                        Für MAGYC DRINKS GmbH:<br/><br/>
                        ______________________________<br/>
                        Unterschrift, Datum
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_uebergabeprotokoll">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="magyc_commission.report_uebergabeprotokoll_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
