<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_lieferschein" model="ir.actions.report">
        <field name="name">Lieferschein Kommission</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">magyc_commission.report_lieferschein</field>
        <field name="print_report_name">'Lieferschein-%s' % (object.name)</field>
    </record>

    <template id="report_lieferschein_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Lieferschein Kommission</h2>
                <div class="row mt-3">
                    <div class="col-6">
                        <strong>Kiosk</strong>
                        <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                        <div t-if="o.partner_id.kiosk_gln">GLN: <span t-field="o.partner_id.kiosk_gln"/></div>
                    </div>
                    <div class="col-6">
                        <strong>Beleg</strong>
                        <div t-field="o.name"/>
                        <div t-field="o.scheduled_date"/>
                        <div t-if="o.magyc_vehicle_location_id">Fahrzeuglager: <span t-field="o.magyc_vehicle_location_id"/></div>
                    </div>
                </div>
                <table class="table table-sm mt-4">
                    <thead>
                        <tr>
                            <th>Artikel</th>
                            <th>GTIN</th>
                            <th class="text-end">Menge</th>
                            <th>Charge</th>
                            <th>MHD</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.move_ids" t-as="move">
                            <td><span t-field="move.product_id"/></td>
                            <td><span t-out="move.product_id.barcode or ''"/></td>
                            <td class="text-end"><span t-field="move.quantity"/></td>
                            <td>
                                <t t-foreach="move.move_line_ids" t-as="ml">
                                    <div><span t-out="ml.lot_id.name or ''"/></div>
                                </t>
                            </td>
                            <td>
                                <t t-foreach="move.move_line_ids" t-as="ml">
                                    <div><span t-out="ml.lot_id.expiration_date or ''"/></div>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p class="mt-3">Die Ware bleibt bis zum Abverkauf Eigentum der MAGYC DRINKS GmbH.</p>
                <div class="row mt-5">
                    <div class="col-6">
                        Ware übernommen:<br/><br/>
                        ______________________________<br/>
                        Unterschrift, Datum
                    </div>
                    <div class="col-6">
                        Für MAGYC DRINKS GmbH:<br/><br/>
                        ______________________________<br/>
                        Unterschrift, Datum
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_lieferschein">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="magyc_commission.report_lieferschein_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_kiosk_contract" model="ir.actions.report">
        <field name="name">Kiosk-Vertrag</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">magyc_commission.report_kiosk_contract</field>
        <field name="print_report_name">'Kioskvertrag-%s' % (object.kiosk_id or object.name)</field>
    </record>

    <template id="report_kiosk_contract_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Kommissions- und Liefervertrag</h2>
                <p>Zwischen der MAGYC DRINKS GmbH und dem nachstehenden Kiosk wird ein Vertrag über
                    Kommissionsware mit einer Laufzeit von
                    <span t-field="o.contract_term_months"/> Monaten geschlossen.</p>
                <table class="table table-sm mt-3">
                    <tr><td style="width:35%">Kiosk</td><td><span t-field="o.name"/></td></tr>
                    <tr><td>Kiosk-ID</td><td><span t-field="o.kiosk_id"/></td></tr>
                    <tr><td>GLN</td><td><span t-field="o.kiosk_gln"/></td></tr>
                    <tr><td>Anschrift</td><td><span t-field="o.street"/> <span t-field="o.zip"/> <span t-field="o.city"/></td></tr>
                    <tr><td>Telefon</td><td><span t-field="o.phone"/></td></tr>
                    <tr><td>IBAN</td><td><span t-field="o.kiosk_iban"/></td></tr>
                    <tr><td>Vertragsbeginn</td><td><span t-field="o.contract_start"/></td></tr>
                    <tr><td>Vertragsende</td><td><span t-field="o.contract_end"/></td></tr>
                    <tr><td>Status</td><td><span t-field="o.kiosk_status"/></td></tr>
                </table>
                <p class="mt-3">Die Ware bleibt bis zum Verkauf Eigentum der MAGYC DRINKS GmbH. Abgerechnet wird
                    monatlich auf Basis der Bestandsaufnahme, Rechnungen werden ab 24 Dosen erstellt. Ein Pfand wird
                    mit der Abverkaufsrechnung abgerechnet.</p>
                <div class="row mt-5">
                    <div class="col-6">
                        MAGYC DRINKS GmbH<br/><br/>
                        ______________________________<br/>
                        Unterschrift, Datum
                    </div>
                    <div class="col-6">
                        Kiosk<br/><br/>
                        ______________________________<br/>
                        Unterschrift, Datum
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_kiosk_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="magyc_commission.report_kiosk_contract_document" t-lang="o.lang"/>
            </t>
        </t>
    </template>

    <record id="ir_cron_magyc_missing_counts" model="ir.cron">
        <field name="name">MAGYC: fehlende Abverkaufsmeldungen erinnern</field>
        <field name="model_id" ref="model_magyc_abverkauf"/>
        <field name="state">code</field>
        <field name="code">model._cron_missing_counts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
