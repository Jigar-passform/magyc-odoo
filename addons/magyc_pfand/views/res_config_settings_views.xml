<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_pfand" model="ir.ui.view">
        <field name="name">res.company.form.pfand</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Pfand (MAGYC)" name="magyc_pfand">
                    <group>
                        <group>
                            <field name="pfand_auto_add"/>
                            <field name="pfand_product_id" invisible="not pfand_auto_add"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
