<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_form_warehouse" model="ir.ui.view">
        <field name="name">stock.location.form.magyc.warehouse</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="MAGYC Lager">
                    <field name="magyc_zone"/>
                    <field name="magyc_bin_code"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_magyc_bin" model="ir.actions.act_window">
        <field name="name">Stellplätze</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("magyc_bin_code", "!=", False)]</field>
        <field name="context">{}</field>
    </record>

    <record id="view_magyc_bin_list" model="ir.ui.view">
        <field name="name">stock.location.list.magyc.bin</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="magyc_bin_code"/>
                <field name="magyc_zone"/>
                <field name="complete_name"/>
                <field name="usage"/>
            </list>
        </field>
    </record>
</odoo>
