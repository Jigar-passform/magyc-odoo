<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_warehouse" model="ir.ui.view">
        <field name="name">stock.picking.form.magyc.warehouse</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_magyc_open_receipt" type="object"
                        string="Wareneingang buchen" class="btn-primary"
                        invisible="picking_type_code != 'incoming' or not origin"/>
                <button name="action_magyc_move_to_packing" type="object"
                        string="In Packplatz umlagern" class="btn-primary"
                        invisible="picking_type_code != 'outgoing' or state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="magyc_packing_bin_id"
                       invisible="picking_type_code != 'outgoing'"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
