<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_bin_label" model="ir.actions.report">
        <field name="name">Stellplatz-Etiketten</field>
        <field name="model">stock.location</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">magyc_warehouse.report_bin_label</field>
        <field name="print_report_name">'Stellplatz-Etiketten'</field>
    </record>

    <template id="report_bin_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div style="border:2px solid #000; padding:8px; margin:4px; width:68mm; text-align:center; page-break-inside:avoid;">
                        <div style="font-size:11px; letter-spacing:1px;">MAGYC LAGER</div>
                        <div style="font-size:22px; font-weight:bold; margin-top:2px;">
                            <t t-out="doc.magyc_bin_code or doc.name"/>
                        </div>
                        <div style="margin-top:6px;">
                            <img t-if="doc.barcode"
                                 t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=380&amp;height=90' % doc.barcode"
                                 style="width:62mm;"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
