<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_magyc_bin_transfer_form" model="ir.ui.view">
        <field name="name">magyc.bin.transfer.form</field>
        <field name="model">magyc.bin.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_transfer" type="object" string="Umlagern" class="btn-primary"/>
                </header>
                <group>
                    <group>
                        <field name="source_bin"/>
                        <field name="product_id"/>
                    </group>
                    <group>
                        <field name="dest_bin"/>
                        <field name="qty"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="action_magyc_bin_transfer" model="ir.actions.act_window">
        <field name="name">Umlagerung</field>
        <field name="res_model">magyc.bin.transfer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
