<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_magyc_label_wizard_form" model="ir.ui.view">
        <field name="name">magyc.label.wizard.form</field>
        <field name="model">magyc.label.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print" type="object" string="Drucken" class="btn-primary"/>
                </header>
                <group>
                    <group>
                        <field name="filter_zone"/>
                        <field name="label_count"/>
                    </group>
                    <group>
                        <field name="picking_id" readonly="1"/>
                    </group>
                </group>
                <field name="location_ids" widget="many2many_tags"/>
            </form>
        </field>
    </record>

    <record id="action_magyc_label_wizard" model="ir.actions.act_window">
        <field name="name">Etiketten drucken</field>
        <field name="res_model">magyc.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
