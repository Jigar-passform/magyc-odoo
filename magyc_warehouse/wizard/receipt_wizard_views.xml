<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_magyc_receipt_wizard_form" model="ir.ui.view">
        <field name="name">magyc.receipt.wizard.form</field>
        <field name="model">magyc.receipt.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_book" type="object" string="Buchen" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="picking_id" readonly="1"/>
                            <field name="purchase_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="label_count"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id" readonly="1"/>
                            <field name="lot_name"/>
                            <field name="expiry_date"/>
                            <field name="qty"/>
                            <field name="location_dest_id" options="{'no_create': True}"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
